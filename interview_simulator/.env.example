# Postgres connection
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/interview_simulator

# --- LLM Provider ---
# Set LLM_PROVIDER to "openai" or "ollama"
LLM_PROVIDER=openai

# Used if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Used if LLM_PROVIDER=ollama (local Llama-3 via Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
